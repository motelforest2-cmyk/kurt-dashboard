# ─── Configurazione Alan Render ─────────────────────────────────────────────
# Copia questo file in ".env" (in locale) oppure imposta queste variabili
# nel pannello di Render (Environment). NON committare il .env vero.

# Porta HTTP. Su Render viene iniettata automaticamente: lasciala non impostata
# in produzione, il codice usa process.env.PORT.
PORT=3000

# ─── Worker Cloudflare ──────────────────────────────────────────────────────
# Base URL del tuo Worker (lo stesso dell'Alan vero).
WORKER_BASE_URL=https://alan-stats.watusigold99.workers.dev

# Identità di questo servizio verso il Worker (header X-Alan-Id). Un valore
# fisso qualsiasi va bene: identifica "il sito" tra i client del Worker.
WORKER_BOT_ID=alan-render-web

# Segreto HMAC — DI NORMA LASCIALO VUOTO.
# Il sito se lo fa dare da solo dal Worker (POST /register-bot) al primo avvio.
# Compilalo a mano SOLO se vuoi forzare un secret specifico per un test.
WORKER_HMAC_SECRET=

# ─── Limiti ─────────────────────────────────────────────────────────────────
# Massimo numero di pairing in corso contemporaneamente (protegge la RAM).
MAX_SESSIONI=15
